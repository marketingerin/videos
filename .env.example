# ─────────────────────────────────────────────────────────────
# Social Media Inbox Manager — variáveis de ambiente
# Copie este arquivo para .env e preencha com suas credenciais.
# Sem credenciais o app roda em MODO DEMO (dados de exemplo).
# ─────────────────────────────────────────────────────────────

# Porta HTTP (a maioria das plataformas de deploy define isso automaticamente)
PORT=3000

# ── Meta Graph API (Instagram + Facebook) ──
# Page Access Token com permissões de messaging/comments.
META_PAGE_ACCESS_TOKEN=
# ID da página do Facebook (para comentários e Messenger)
META_PAGE_ID=
# ID da conta do Instagram Business (opcional; usa a página se ausente)
META_IG_USER_ID=
# Versão da Graph API
META_API_VERSION=v19.0

# ── TikTok API for Business ──
TIKTOK_ACCESS_TOKEN=

# ── ActiveCampaign ──
# URL base da sua conta, ex.: https://suaconta.api-us1.com
ACTIVECAMPAIGN_BASE_URL=
ACTIVECAMPAIGN_API_TOKEN=
# Nome da lista para novos leads (padrão: "Meta Ads")
ACTIVECAMPAIGN_LIST_NAME=Meta Ads
# Username/nome do owner dos deals a receber notas (padrão: "Oner")
ACTIVECAMPAIGN_DEAL_OWNER=Oner

# ── Segurança do painel ──
# Se definido, o painel exige este token no header "x-inbox-token" ou ?token=
DASHBOARD_TOKEN=
